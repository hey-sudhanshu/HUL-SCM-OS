    it('Holding-cost reconciliation', () => {
        const h = compute_holding_cost(mockSku, 1000, mockCostParams).outputs;
        expect(h.total).toBeCloseTo(h.capital + h.storage + h.insurance + h.shrinkage, 1);
        expect(h.capital).toBe(15000);
    });

