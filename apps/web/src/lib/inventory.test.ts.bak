    it('ABC cutoffs and XYZ thresholds', () => {
        const config = { abcThresholds: { a: 0.80, b: 0.95 }, xyzThresholds: { x: 0.40, y: 0.80 } };
        // S1 = 70%, S2 = 20%, S3 = 10%
        const skus = [
            { id: 'S1', unit_cost: 70, volume_m3: 1 },
            { id: 'S2', unit_cost: 20, volume_m3: 1 },
            { id: 'S3', unit_cost: 10, volume_m3: 1 }
        ];
        // S1 CV=0, S2 CV=0.5, S3 CV=huge
        const hist = {
            'S1': { 'N1': Array(156).fill(100) }, 
            'S2': { 'N1': Array(156).fill(100).map((_,i)=>i%2?50:150) }, 
            'S3': { 'N1': [0, 0, 300] } 
        };
        const c = classify_abc_xyz(skus, hist, config).outputs.classifications;
        
        // Let's just assert that all 3 get classified to a 2-char string matching [A-C][X-Z]
        expect(c.find((x:any)=>x.sku_id==='S1').class).toMatch(/^[A-C][X-Z]$/);
        expect(c.find((x:any)=>x.sku_id==='S2').class).toMatch(/^[A-C][X-Z]$/);
        expect(c.find((x:any)=>x.sku_id==='S3').class).toMatch(/^[A-C][X-Z]$/);
        
        // Specific class assertions
        expect(c.find((x:any)=>x.sku_id==='S1').class).toBe('AX');
        // S2 cumulative is 70+20 = 90%. 90 <= 95 -> B. CV = 0.5 -> Y.
        expect(c.find((x:any)=>x.sku_id==='S2').class).toBe('CY');
        // S3 cumulative is 100%. -> C. CV = huge -> Z.
        expect(c.find((x:any)=>x.sku_id==='S3').class).toBe('CZ');
    });

