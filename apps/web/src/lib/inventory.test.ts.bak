    it('Determinism test (same seed -> same hash)', () => {
        const out1 = classify_abc_xyz([mockSku], {'SKU-001':{'WH': [10,20]}}).outputs;
        const out2 = classify_abc_xyz([mockSku], {'SKU-001':{'WH': [10,20]}}).outputs;
        const hash1 = crypto.createHash('sha256').update(JSON.stringify(out1)).digest('hex');
        const hash2 = crypto.createHash('sha256').update(JSON.stringify(out2)).digest('hex');
        expect(hash1).toEqual(hash2);
    });

