        const classes = classify_abc_xyz(net.skus, net.demand_history, config).outputs.classifications;
        const classMap = {};
        classes.forEach(c => classMap[c.sku_id] = c.class);

        const ropSet = new Set();
        let hugeCoverCount = 0;

        net.skus.forEach(sku => {
            const hists = net.demand_history[sku.id];
            if(!hists) return;
            const cls = classMap[sku.id] || 'CZ';
            const costp = {
                capital_cost_rate: (net.cost_parameters.capital_cost_rate_pct || 15) / 100,
                storage_cost_per_pallet_day: net.cost_parameters.storage_cost_per_pallet_day || 15,
                insurance_rate: (net.cost_parameters.insurance_rate_pct || 1.5) / 100,
                shrinkage_rate: (net.cost_parameters.shrinkage_obsolescence_pct || 2) / 100
            };

            Object.entries(hists).forEach(([node, hist]) => {
                if(!hist || hist.length === 0) return;
                const mean = hist.reduce((a,b)=>a+b,0) / hist.length;
                if(mean === 0) return;
                const std = Math.sqrt(hist.reduce((a,b)=>a+Math.pow(b-mean,2),0) / hist.length);
                
                // Pipeline LT (3 days)
                const lt = 3; 
                const lt_std = 0;

                const res = compute_inventory_policy(sku, cls, mean, std, lt, lt_std, costp).outputs;
                
                // ROP >= mean demand during lead time
                const pipeline_demand = mean * (lt/7.0);
                expect(res.rop).toBeGreaterThanOrEqual(pipeline_demand);
                
                // SS >= 0, Order Qty >= 0
                expect(res.ss).toBeGreaterThanOrEqual(0);
                expect(res.eoq).toBeGreaterThanOrEqual(0);
                
                // No NaNs
                expect(Number.isNaN(res.rop)).toBe(false);
                expect(Number.isNaN(res.ss)).toBe(false);
                expect(Number.isNaN(res.eoq)).toBe(false);

                // Ensure ROPs are not constant
                ropSet.add(res.rop.toFixed(4));
                
                // Days of cover check
                const daysOfCover = (res.eoq / mean) * 7;
                if(daysOfCover > 60) {
                    hugeCoverCount++;
                }
            });
        });

        // Assert that we have many unique ROPs (not constant across SKUs or nodes)
        expect(ropSet.size).toBeGreaterThan(100);
        
        // Assert some huge covers exist due to MOQ (e.g. 16T minimum vs low demand)
        expect(hugeCoverCount).toBeGreaterThan(0);
    });

