    it('Baseline vs optimized reconciliation', () => {
        const res = compute_inventory_policy(mockSku, 'AX', 100, 20, 14, 2, mockCostParams, 0.95);
        const optUnits = res.outputs.ss + res.outputs.eoq/2 + res.outputs.pipeline;
        const optValue = optUnits * mockSku.unit_cost;
        
        const baseUnits = 100 * 30; // 30-day cover baseline
        const baseValue = baseUnits * mockSku.unit_cost;
        
        expect(optValue).toBeGreaterThan(0);
        expect(baseValue).toBe(300000); 
        expect(optValue).toBeLessThan(baseValue); 
    });

