import { describe, it, expect } from 'vitest';
import * as fs from 'fs';
import { diagnoseAndPropose } from '../lib/copilot';
import { useGovernanceStore } from '../lib/governanceStore';
import path from 'path';

describe('Phase 7 Scoped Agent Flow', () => {
  it('EVIDENCE: Orchestrator flow prints step trace, plan card, and queue entry', () => {
    console.log('\n=== COPILOT AGENT TRACE ===');
    const p = path.resolve(__dirname, '../../../../data/network.json');
    const net = JSON.parse(fs.readFileSync(p, 'utf8'));
    
    const { logs, planCard } = diagnoseAndPropose(net);
    
    logs.forEach((log, i) => {
      console.log(`\nStep ${i+1}: ${log.step}`);
      console.log(`Tool: ${log.tool}`);
      console.log(`Input: ${JSON.stringify(log.input)}`);
      console.log(`Output: ${JSON.stringify(log.output)}`);
    });
    
    console.log('\n=== FINAL PLAN CARD ===');
    console.log(JSON.stringify(planCard, null, 2));
    
    console.log('\n=== GOVERNANCE QUEUE INTEGRATION ===');
    useGovernanceStore.setState({ queue: [], currentRole: 'AI Agent' });
    useGovernanceStore.getState().enqueue(
      'shift a distributor cluster',
      'Copilot Agent',
      { action: planCard.action },
      planCard.before_kpis,
      planCard.after_kpis
    );
    const q = useGovernanceStore.getState().queue[0];
    expect(q).toBeDefined();
    
    console.log(`Queued ID: ${q.id}`);
    console.log(`Decision: ${q.decision}`);
    console.log(`Requested By: ${q.requestedBy}`);
    console.log(`Context: ${JSON.stringify(q.context)}`);
    console.log(`Before KPIs: ${JSON.stringify(q.before_kpis)}`);
    console.log(`After KPIs: ${JSON.stringify(q.after_kpis)}`);
    console.log(`Status: ${q.status}`);
  });
});
